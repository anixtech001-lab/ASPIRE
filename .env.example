# Groq — required for the AI feasibility report
GROQ_API_KEY=your_groq_api_key_here

# Bhashini — optional for MVP demo (app works with fallback if not set)
# Register at https://bhashini.gov.in/ubhasini/en/signup
BHASHINI_USER_ID=
BHASHINI_API_KEY=

# Firebase — required for the Community feature (shared problem/solution
# board). Get these from Firebase Console → Project Settings → Your apps.
# Also enable Firestore Database and Authentication → Anonymous sign-in.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
